# Sao chép file này thành .env rồi chỉnh sửa (file .env không được commit).

# development: lỗi hiện dưới dạng TOAST; bấm vào toast để mở POPUP chi tiết (stack trace, file:dòng).
# production : người dùng chỉ thấy thông báo chung, không lộ stack trace.
# Nếu không đặt NODE_ENV, mặc định là development.
NODE_ENV=development

PORT=3000
APP_URL=http://localhost:3000
STORAGE_PROVIDER=memory

# Bắt buộc đặt giá trị thật khi chạy production (Render tự sinh qua render.yaml).
# SESSION_SECRET=
# CSRF_SECRET=
