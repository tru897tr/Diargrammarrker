{
  "name": "diagram",
  "version": "1.0.0",
  "description": "Diagram — web app tạo sơ đồ trực tuyến với infinite canvas, chạy trên Render",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "src/server/server.js",
  "scripts": {
    "start": "node src/server/server.js",
    "dev": "node --watch src/server/server.js",
    "test": "node --test",
    "test:unit": "node --test tests/embedHosts.test.js tests/schema.test.js tests/preview.test.js",
    "test:api": "node --test tests/diagrams.api.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "zod": "^3.25.76"
  }
}
